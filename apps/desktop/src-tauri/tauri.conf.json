{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxel Realms",
  "version": "1.0.0",
  "identifier": "app.voxelrealms.desktop",
  "build": {
    "frontendDist": "../../launcher"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voxel Realms",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http: https: ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Voxel Realms game client"
  }
}
